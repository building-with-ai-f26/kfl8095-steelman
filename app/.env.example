# Copy to .env (never committed) and fill in. Names only here, never values.

# The Postgres database. For the one in compose.yaml, which takes no password
# and listens only on this machine: postgres://steelman@127.0.0.1:5432/steelman
DATABASE_URL=

# Signs session cookies. Any long random string; make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required when deployed. Under npm run dev, a new one is made each start if
# this is empty, which signs everyone out on restart.
BETTER_AUTH_SECRET=

# Where the site is, as the browser sees it: under npm run dev,
# http://localhost:5173. Writes are accepted only from here.
APP_ORIGIN=

# Google sign-in. Without both, only email codes work. Locally, use the staging
# OAuth client (its ID is in plans/build-plan.md, under M1; the secret is kept
# by the builder, never in a file that's committed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analytics and session replay in the browser, through PostHog. Without the
# key, the app sends nothing. It's the project's public key, the one
# docs/analytics.js uses (it can send events but not read them). The host is
# PostHog's US cloud unless you say otherwise.
POSTHOG_KEY=
POSTHOG_HOST=

# Deployed only (M1-14a). Sign-in codes are emailed through Resend: its API
# key (kept by the builder, reaching the service through Secret Manager) and
# the sender, on the domain Resend has verified, e.g.
#   Steelman <sign-in@send.steelman-argument.com>
# Without both, a deployed service runs without sign-in. Under npm run dev,
# codes are printed to the terminal instead and these are ignored.
RESEND_API_KEY=
EMAIL_FROM=

# Set by the container (app/Dockerfile), not by hand: where the built web app
# and the migrations are, and to listen on every address.
WEB_DIRECTORY=
MIGRATIONS_DIRECTORY=
HOST=

# The migration job only (M1-14b): it signs in as the database's owner
# (DATABASE_URL), then creates the service's own login with these, which has
# steelman_app's rights and nothing more. Terraform sets them; leave empty here.
SERVICE_DATABASE_USER=
SERVICE_DATABASE_PASSWORD=
