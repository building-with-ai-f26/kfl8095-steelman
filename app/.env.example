# Copy to .env (never committed) and fill in. Names only here, never values.

# The Postgres database. For the one in compose.yaml, which takes no password
# and listens only on this machine: postgres://steelman@127.0.0.1:5432/steelman
DATABASE_URL=

# Signs session cookies. Any long random string; make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required when deployed. Under npm run dev, a new one is made each start if
# this is empty, which signs everyone out on restart.
BETTER_AUTH_SECRET=

# Where the site is, as the browser sees it: under npm run dev,
# http://localhost:5173. Writes are accepted only from here.
APP_ORIGIN=

# Google sign-in. Without both, only email codes work. Locally, use the staging
# OAuth client (its ID is in plans/build-plan.md, under M1; the secret is kept
# by the builder, never in a file that's committed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
