{
  "name": "steelman",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc -p . && tsc -p shared && tsc -p server && tsc -p web",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "db:migrate": "npm run db:migrate --workspace @steelman/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
