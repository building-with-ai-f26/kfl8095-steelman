{
  "name": "steelman",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:browser",
    "typecheck": "tsc -p . && tsc -p shared && tsc -p server && tsc -p web && tsc -p e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "db:migrate": "npm run db:migrate --workspace @steelman/server",
    "db:seed": "npm run db:seed --workspace @steelman/server",
    "test:browser": "playwright test",
    "test:soak": "tsx server/test/soak/run.ts",
    "test:mutation": "tsx scripts/mutation/run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
